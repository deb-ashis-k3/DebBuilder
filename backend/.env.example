DATABASE_URL=postgresql+psycopg://postgres:dev%40123@localhost:5432/debbuilder
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Shared secret between the API and voice/worker.py
INTERNAL_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Security: sign-in attempts per IP per minute; allow the first owner setup from another machine
LOGIN_RATE_LIMIT=10
ALLOW_REMOTE_SETUP=false

# Email for sign-in codes (every sign-in needs a code sent to the user's email).
# Microsoft 365: smtp.office365.com / 587 / starttls   Gmail: smtp.gmail.com / 587 / starttls (app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=
# Without SMTP_HOST: "log" writes codes to the backend console (local development only); "off" refuses sign-in.
EMAIL_CODE_FALLBACK=log

# Voice workers: "auto" = the backend runs voice/worker.py for each active voice workflow (per LiveKit
# credential + agent name); "off" = run them yourself. Warm call processes per worker (memory ~ models).
VOICE_WORKERS=auto
VOICE_WORKER_IDLE_PROCESSES=1
# How workers reach the API (default http://127.0.0.1:$PORT)
INTERNAL_API_URL=
# Fallback LiveKit project when a Voice Agent trigger has no LiveKit credential / for a manually run worker
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEBBUILDER_API=http://localhost:8000
# Used for inbound SIP calls whose dispatch has no workflow_id
DEFAULT_VOICE_WORKFLOW_ID=
