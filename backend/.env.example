DATABASE_URL=postgresql+psycopg://postgres:dev%40123@localhost:5432/debbuilder
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Shared secret between the API and voice/worker.py
INTERNAL_TOKEN=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Security: sign-in attempts per IP per minute; allow the first owner setup from another machine
LOGIN_RATE_LIMIT=10
ALLOW_REMOTE_SETUP=false
# Self-registration from the sign-in page (new accounts are editors with an empty workspace). Off: admins add users.
ALLOW_SIGNUP=false
# Outbound requests (HTTP Request node, import from URL, credential tests, model lists) may not reach private,
# loopback or link-local addresses. Allow hosts / CIDRs your workflows call on your network, or all private ones:
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_ALLOW_PRIVATE=false
# Limits: largest request body in MB (413 above); open connections per process before 503 (0 = 400 on Windows,
# 2000 elsewhere); executions waiting for a slot before webhooks answer 503; Code node run time / memory.
MAX_REQUEST_BODY_MB=16
MAX_CONNECTIONS=0
MAX_QUEUED_EXECUTIONS=5000
CODE_TIMEOUT_SECONDS=60
CODE_MEMORY_MB=512

# Email for sign-in codes (every sign-in needs a code sent to the user's email).
# Microsoft 365: smtp.office365.com / 587 / starttls   Gmail: smtp.gmail.com / 587 / starttls (app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
MAIL_FROM=
# Without SMTP_HOST: "log" writes codes to the backend console (local development only); "off" refuses sign-in.
EMAIL_CODE_FALLBACK=log

# Voice workers: "auto" = the backend runs voice/worker.py for each active voice workflow (per LiveKit
# credential + agent name); "off" = run them yourself. Warm call processes per worker (memory ~ models).
VOICE_WORKERS=auto
# Several replicas: "auto" = one elected replica runs schedules, listeners and voice workers; "off" = never (web only)
BACKGROUND_TASKS=auto

# ---- traffic / execution history (see backend/app/engine/store.py) ----
# Executions running at once per process (they hold no DB connection while running).
MAX_CONCURRENT_EXECUTIONS=200
# What history to keep: all | none (each workflow can override in its settings). Paused runs are always kept.
EXECUTIONS_SAVE_SUCCESS=all
EXECUTIONS_SAVE_ERROR=all
EXECUTIONS_SAVE_MANUAL=true
# full = every node's items; summary = status, timings and counts only (far smaller rows at high volume)
EXECUTIONS_SAVE_DATA=full
# Batched writer: flush every N ms or when this many rows wait; producers wait beyond MAX_PENDING (backpressure)
EXECUTIONS_FLUSH_MS=200
EXECUTIONS_BATCH_SIZE=500
EXECUTIONS_MAX_PENDING=20000
# Retention (run by the leader): days of history to keep (0 = forever); runs left "running" by a crash
EXECUTIONS_MAX_AGE_DAYS=14
EXECUTIONS_STALE_AFTER_HOURS=12
# Connections per process: DB_POOL_SIZE + DB_MAX_OVERFLOW + ~13 (checkpointer pool, leader lock, change listener).
# Keep replicas x that below Postgres max_connections, or put PgBouncer (transaction mode) in front.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Keep-alive longer than the load balancer's idle timeout (avoids random 502s under load)
KEEPALIVE_TIMEOUT=90
VOICE_WORKER_IDLE_PROCESSES=1
# How workers reach the API (default http://127.0.0.1:$PORT)
INTERNAL_API_URL=
# Fallback LiveKit project when a Voice Agent trigger has no LiveKit credential / for a manually run worker
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEBBUILDER_API=http://localhost:8000
# Used for inbound SIP calls whose dispatch has no workflow_id
DEFAULT_VOICE_WORKFLOW_ID=
